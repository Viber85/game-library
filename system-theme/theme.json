{
  "name": "Game Library Midnight",
  "author": "Viber85",
  "version": "v0.2.0-test.14",
  "manifest_version": 8,
  "target": "System-Wide",
  "description": "Matching Game Library midnight blue / cyan colors for Steam menus, Quick Access, Settings, Downloads, buttons and dialogs. Colors only; original Steam navigation preserved.",
  "tabs": {
    "all": [
      "bigpicture",
      "bigpictureoverlay"
    ]
  },
  "inject": {
    "shared.css": [
      "bigpicture",
      "bigpictureoverlay"
    ],
    "buttons.css": [
      "bigpicture",
      "bigpictureoverlay"
    ],
    "menus.css": [
      "bigpictureoverlay"
    ],
    "qam.css": [
      "bigpicture",
      "bigpictureoverlay"
    ],
    "settings.css": [
      "bigpicture"
    ],
    "downloads.css": [
      "bigpicture"
    ],
    "dialogs.css": [
      "bigpicture",
      "bigpictureoverlay"
    ]
  }
}
